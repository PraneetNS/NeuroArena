{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@na/ml-core": ["packages/ml-core/src/index.ts"],
      "@na/ml-core/*": ["packages/ml-core/src/*"],
      "@na/game-core": ["packages/game-core/src/index.ts"],
      "@na/game-core/*": ["packages/game-core/src/*"],
      "@na/engine": ["packages/engine/src/index.ts"],
      "@na/ui": ["packages/ui/src/index.ts"],
      "@na/ui/styles": ["packages/ui/src/styles/theme.css"],
      "@na/ui/*": ["packages/ui/src/*"],
      "@nа/ml-core": ["packages/ml-core/src/index.ts"]
    }
  }
}
